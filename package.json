{
  "name": "beelite",
  "productName": "BeeLite",
  "version": "0.1.8",
  "description": "艾泽魔方 · AzerCube：精简的魔兽世界插件搜索、安装与管理工具（macOS）",
  "private": true,
  "main": "dist/app/main/main.js",
  "license": "UNLICENSED",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && tsc -p tsconfig.web.json && node scripts/copy-static.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json && node --test \"build-test/test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "smoke": "tsc -p tsconfig.test.json && node build-test/scripts/smoke.js",
    "start": "npm run build && electron .",
    "dist": "npm run build && npm run native && electron-builder --mac --arm64 --publish never && node scripts/verify-app.mjs production release/mac-arm64/BeeLite.app",
    "native": "node scripts/fetch-sparkle.mjs && node scripts/build-native.mjs",
    "release:appcast": "node scripts/release-appcast.mjs",
    "e2e:build": "node scripts/build-e2e.mjs"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/yauzl": "3.4.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "node-gyp": "13.1.0",
    "typescript": "5.9.3"
  },
  "build": {
    "appId": "app.beelite.addons",
    "productName": "BeeLite",
    "copyright": "Copyright © 2026 AzerCube",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/app/**",
      "dist/web/**",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "CFBundleDisplayName": "BeeLite",
        "CFBundleDevelopmentRegion": "en",
        "SUFeedURL": "https://github.com/NginxL/beelite/releases/latest/download/appcast.xml",
        "SUPublicEDKey": "1QVzcH29FNZEGtdtqFiWCYM5a51IpLd6CsanZIcXXTI=",
        "SUEnableAutomaticChecks": false,
        "SUAutomaticallyUpdate": false,
        "SUAllowsAutomaticUpdates": false,
        "SUVerifyUpdateBeforeExtraction": true,
        "SURequireSignedFeed": true,
        "SUSignedFeedFailureExpirationInterval": 0
      }
    },
    "electronLanguages": [
      "zh_CN",
      "en"
    ],
    "afterPack": "scripts/after-pack.cjs"
  },
  "author": "AzerCube"
}
